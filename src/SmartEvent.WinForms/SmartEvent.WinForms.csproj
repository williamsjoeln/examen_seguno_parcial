<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CAPA PRESENTACION (Windows Forms, .NET 8)
    Es el punto de entrada y la RAIZ DE COMPOSICION: el unico lugar donde se
    referencian Infraestructura e Integraciones, y solo dentro de
    Composicion/ContenedorServicios.cs para registrarlas en el contenedor de
    inyeccion de dependencias.

    Los formularios NUNCA usan SqlConnection, SmtpClient ni HttpClient:
    reciben interfaces de la capa Aplicacion por constructor (Examen §8).

    UserSecretsId permite guardar la API key de OpenAI y la clave SMTP fuera
    del repositorio con `dotnet user-secrets`.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <RootNamespace>SmartEvent.WinForms</RootNamespace>
    <AssemblyName>SmartEvent.WinForms</AssemblyName>
    <UserSecretsId>smartevent-ai-2026-navarrete</UserSecretsId>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartEvent.Dominio\SmartEvent.Dominio.csproj" />
    <ProjectReference Include="..\SmartEvent.Aplicacion\SmartEvent.Aplicacion.csproj" />
    <ProjectReference Include="..\SmartEvent.Infraestructura\SmartEvent.Infraestructura.csproj" />
    <ProjectReference Include="..\SmartEvent.Integraciones\SmartEvent.Integraciones.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup>
    <!-- appsettings.example.json se copia junto al ejecutable solo como
         plantilla de referencia; NO contiene secretos. -->
    <None Update="appsettings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
