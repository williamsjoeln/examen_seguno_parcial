<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CAPA DOMINIO
    Entidades, enumeraciones, reglas puras y objetos de valor.
    NO tiene dependencias de infraestructura (ni SQL, ni HTTP, ni WinForms):
