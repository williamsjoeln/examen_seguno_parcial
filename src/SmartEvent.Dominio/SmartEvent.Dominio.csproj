    paquete NuGet ni ningun otro proyecto.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SmartEvent.Dominio</RootNamespace>
    <AssemblyName>SmartEvent.Dominio</AssemblyName>
  </PropertyGroup>

</Project>
