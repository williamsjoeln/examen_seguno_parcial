# =============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO - SmartEvent AI
#
# Las variables de entorno tienen PRIORIDAD sobre appsettings.json.
# El separador de nivel es doble guion bajo:  Seccion__Clave
#
# ESTE ARCHIVO SOLO CONTIENE VALORES FICTICIOS.
# El archivo real .env esta en .gitignore y nunca se sube al repositorio.
#
# En Windows, para dejarlas guardadas en su perfil de usuario, ejecute en
# PowerShell (una linea por variable):
#
#   [Environment]::SetEnvironmentVariable('NOMBRE','valor','User')
#
# Despues cierre y vuelva a abrir la terminal para que surtan efecto.
# =============================================================================

# --- Base de datos -----------------------------------------------------------
# Reemplace SERVIDOR_EJEMPLO por su instancia: .\SQLEXPRESS, (local), .\MSSQLSERVER_2026 ...
# Trusted_Connection=True usa la sesion de Windows, por lo que NO hay contrasena.
ConnectionStrings__SmartEventDb=Server=SERVIDOR_EJEMPLO;Database=SmartEventAI;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=True;Connect Timeout=15;Application Name=SmartEventAI

# --- OpenAI (Responses API) --------------------------------------------------
# Clave real de OpenAI: https://platform.openai.com/api-keys  (requiere saldo)
# Alternativa gratuita que implementa la MISMA Responses API: https://console.groq.com
OPENAI_API_KEY=TU_API_KEY_AQUI

# Con OpenAI:
#   OpenAI__BaseUrl=https://api.openai.com/v1
#   OpenAI__Modelo=gpt-5-mini
# Con Groq (nivel gratuito, sin tarjeta):
#   OpenAI__BaseUrl=https://api.groq.com/openai/v1
#   OpenAI__Modelo=openai/gpt-oss-120b
OpenAI__BaseUrl=https://api.openai.com/v1
OpenAI__Modelo=gpt-5-mini
OpenAI__SegundosTiempoEspera=60

# --- Correo SMTP -------------------------------------------------------------
# Para las evidencias se recomienda smtp4dev en local: no pide usuario ni clave.
#   dotnet tool install -g Rnwood.Smtp4dev
#   smtp4dev --smtpport=2525 --urls=http://localhost:5080
# Con smtp4dev:  Smtp__Host=localhost  Smtp__Puerto=2525  Smtp__UsarSsl=false
#                Smtp__Usuario y Smtp__Password quedan vacios.
Smtp__Host=SERVIDOR_SMTP_EJEMPLO
Smtp__Puerto=587
Smtp__UsarSsl=true
Smtp__Usuario=USUARIO_EJEMPLO
Smtp__Password=PASSWORD_EJEMPLO
Smtp__RemitenteNombre=SmartEvent AI
Smtp__RemitenteCorreo=no-responder@smartevent.ejemplo.com

# --- Seguridad ---------------------------------------------------------------
Seguridad__MaximoIntentosFallidos=3
Seguridad__MinutosBloqueo=3
