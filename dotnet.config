# Selecciona Microsoft.Testing.Platform como ejecutor de "dotnet test".
# xUnit v3 se ejecuta sobre esa plataforma en lugar del antiguo VSTest.
#
# NOTA: en el SDK 10.0.302 este archivo todavia no basta y "dotnet test" falla.
# El comando fiable en cualquier SDK, y el que documenta el README, es:
#     dotnet run --project tests/SmartEvent.Pruebas
[dotnet.test.runner]
name = "Microsoft.Testing.Platform"
